  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 O rel\xF3gio \xE9 a sua vida: sobreviva o m\xE1ximo que puder.\n\u2022
    Ba\xFA +4s \xB7 Moeda +1s \xB7 Ampulheta +5s \xB7 Boia = escudo\n\u2022 Pegue
    todos os ba\xFAs para come\xE7ar a pr\xF3xima onda (+5s).\n\u2022 Navio pirata
    -5s \xB7 Bala de canh\xE3o -3s \xB7 Tubar\xE3o -3s\n\u2022 A seta amarela aponta
    o ba\xFA mais pr\xF3ximo.\n\nMover: WASD, setas ou anal\xF3gico\nRemada forte:
    Shift ou X (gasta stamina)\nPausar: ESC ou Start"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 37f91a7b9d5d24fcf9ddb3994e43a257, type: 2}
